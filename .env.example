# ─────────────────────────────────────────────────────────────
# Vehicle Ordering API – test configuration
# Copy to `.env` and adjust. Every value is validated at start-up
# by src/config/env.ts (tests) and mock-server/config.ts (mock).
# ─────────────────────────────────────────────────────────────

# ── Target API ───────────────────────────────────────────────
# Base URL of the API under test. Points at the local mock by default;
# switch to a real environment and set START_MOCK_SERVER=false.
API_BASE_URL=http://localhost:3100
# Bearer token sent on every authenticated request (and expected by the mock).
API_TOKEN=local-dev-token

# ── Local mock server ────────────────────────────────────────
# When true, Playwright boots the mock via `webServer` before the run.
START_MOCK_SERVER=true
# Must match the port in API_BASE_URL when using the mock.
MOCK_SERVER_PORT=3100
# Max time Playwright waits for the mock's /health to respond.
WEB_SERVER_TIMEOUT_MS=30000


# ── Run profile ──────────────────────────────────────────────
# Set automatically to "true" by GitHub Actions; leave unset locally.
# local: list reporter + HTML report opened after every run, mock server reused.
# CI:    github + junit + json reporters, HTML only written, forbidOnly, clean mock.
# CI=true
