{
  "name": "qa-vehicle-test",
  "version": "1.0.0",
  "description": "Playwright API automation for the Vehicle Ordering API",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:contract": "playwright test --grep @contract",
    "mock": "tsx mock-server/server.ts",
    "report": "playwright show-report reports/html",
    "trace": "playwright show-trace",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test:security": "playwright test --grep @security"
  },
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
